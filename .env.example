# bubblena-be – environment variables (copy to .env, never commit .env)

PORT=3001
MONGODB_URI=                      # mongodb+srv://user:pass@cluster/db

# Shared with the storefront (NUXT_API_KEY in bubblena-fe) and admin (BE_API_KEY)
API_KEY=
# Shared with the storefront (NUXT_INTERNAL_TOKEN) for BE -> FE calls
INTERNAL_TOKEN=

# Customer auth
JWT_SECRET=                       # openssl rand -hex 32
GOOGLE_CLIENT_ID=                 # optional; Google login disabled when empty
TERMS_VERSION=2026-09             # bump when obchodní podmínky change

# Stripe
STRIPE_SECRET_KEY=                # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=            # whsec_… of the /api/stripe/webhook destination (same mode as the key)

# Storefront origin for Stripe redirects and BE -> FE calls
FRONTEND_URL=https://bubblena.cz
# Optional comma-separated browser origins for CORS (admin). Empty = allow all.
CORS_ORIGINS=

# Carriers
PACKETA_API_KEY=                  # Zásilkovna API password (createPacket)
GLS_API_USERNAME=
GLS_API_PASSWORD=
GLS_API_URL=https://api.mygls.cz/ParcelService.svc/json/PrepareLabels
GLS_CLIENT_NUMBER=
GLS_SENDER_NAME=
GLS_SENDER_STREET=
GLS_SENDER_HOUSE_NUMBER=
GLS_SENDER_ZIP=
GLS_SENDER_CITY=
GLS_SENDER_COUNTRY=CZ
